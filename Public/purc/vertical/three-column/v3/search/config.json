{
  "container": {
    "class": "card shadow-sm border-0 mb-4",
    "header": {
      "title": "3-Column Divided Sections",
      "icon": "bi bi-columns",
      "actions": [
        {
          "id": "card-clear-filters-btn",
          "label": "Clear",
          "icon": "bi bi-x-circle",
          "class": "btn btn-sm btn-outline-secondary"
        }
      ]
    },
    "bodyClass": "card-body"
  },
  "sections": [
    {
      "title": "Voucher Details",
      "icon": "bi bi-receipt text-primary",
      "class": "col-md-4",
      "columns": [
        "vouchernumber",
        "vchtype"
      ]
    },
    {
      "title": "Stock & Godown",
      "icon": "bi bi-building text-info",
      "class": "col-md-4",
      "columns": [
        "stockitemname",
        "godownname"
      ]
    },
    {
      "title": "Batch & Quantity",
      "icon": "bi bi-boxes text-success",
      "class": "col-md-4",
      "columns": [
        "batchname",
        "inwardQty",
        "outwardQty",
        "uom"
      ]
    }
  ],
  "layout": "stacked",
  "searchButtons": false
}
